# ── Symphony · Browser Use Cloud Agent Hub ───────────────────────────────
# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Required. Postgres connection string (Neon, Supabase or any Postgres).
# Tables are created automatically on first request — no migration step.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public origin, used for OAuth redirects and metadata. Set to your live URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional fallbacks. Keys added in the dashboard vault take precedence.
BROWSER_USE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional Google Workspace OAuth client. Can also be saved in the dashboard UI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
